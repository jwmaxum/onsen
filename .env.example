# Supabase Gateway URL including /rest/v1, or the loopback URL of standalone PostgREST.
ONSEN_POSTGREST_URL=http://127.0.0.1:54321/rest/v1
ONSEN_SUPABASE_PUBLIC_KEY=
# Firebase Realtime Database HTTPS origin for the public catalog. Leave empty for local PostgREST.
ONSEN_FIREBASE_DATABASE_URL=
# Set to a random secret of at least 32 characters. Keep this server-side.
ONSEN_CURSOR_SECRET=
# Set this when deploying to a public origin to enable canonical URLs and indexing.
ONSEN_SITE_URL=

# Firebase Console > Project settings > Your apps > Web app SDK configuration.
# These values are public browser configuration. Set them before building the site.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional: setting a measurement ID enables Google Analytics in supported browsers.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Verified Firebase Auth UID used by the project operator to register the administrator.
# Keep it in .env.local. Client authorization is enforced by Firebase Realtime Database rules.
ONSEN_ADMIN_UID=
